{
  "name": "@stylhero/ui",
  "version": "0.4.0",
  "description": "Stylhero design system: tokens, Tailwind theme and React components",
  "license": "MIT",
  "author": "Oscar Ruíz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raiburn/stylhero.git",
    "directory": "ui"
  },
  "homepage": "https://github.com/raiburn/stylhero#readme",
  "bugs": {
    "url": "https://github.com/raiburn/stylhero/issues"
  },
  "keywords": [
    "react",
    "nextjs",
    "design-system",
    "tailwindcss",
    "components",
    "ui",
    "design-tokens",
    "accessibility"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./tokens.css": "./styles/tokens.css",
    "./components.css": "./styles/components.css",
    "./tailwind.css": "./styles/tailwind.css",
    "./base.css": "./styles/base.css",
    "./logo/*": "./logo/*"
  },
  "files": [
    "dist",
    "styles",
    "logo",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:watch": "node --watch-path=../tokens.json scripts/build-tokens.mjs",
    "build": "npm run tokens && tsup && node scripts/fix-dist-imports.mjs",
    "dev": "tsup --watch --onSuccess \"node scripts/fix-dist-imports.mjs\"",
    "typecheck": "tsc --noEmit",
    "playground": "node playground/build.mjs",
    "test": "node playground/build.mjs --no-open && node playground/test.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "check:pack": "npm pack --dry-run",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.24.2",
    "puppeteer-core": "^23.11.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "peerDependenciesMeta": {
    "lucide-react": {
      "optional": true
    }
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20"
  }
}
