{
  "name": "@stylhero/ui",
  "version": "0.4.0",
  "description": "Stylhero design system: tokens, Tailwind theme and React components",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens.css": "./styles/tokens.css",
    "./components.css": "./styles/components.css",
    "./tailwind.css": "./styles/tailwind.css",
    "./base.css": "./styles/base.css",
    "./logo/*": "./logo/*"
  },
  "files": [
    "dist",
    "styles",
    "logo"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:watch": "node --watch-path=../tokens.json scripts/build-tokens.mjs",
    "build": "npm run tokens && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "playground": "node playground/build.mjs",
    "test": "node playground/build.mjs --no-open && node playground/test.mjs",
    "check:pack": "npm pack --dry-run",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.24.2",
    "puppeteer-core": "^23.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "peerDependenciesMeta": {
    "lucide-react": {
      "optional": true
    }
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20"
  }
}
