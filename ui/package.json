{
  "name": "@stylhero/ui",
  "version": "0.4.0",
  "description": "Stylhero design system: tokens, Tailwind theme and React components",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./tokens.css": "./styles/tokens.css",
    "./components.css": "./styles/components.css",
    "./tailwind.css": "./styles/tailwind.css",
    "./base.css": "./styles/base.css",
    "./logo/*": "./logo/*"
  },
  "files": [
    "dist",
    "styles",
    "logo"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:watch": "node --watch-path=../tokens.json scripts/build-tokens.mjs",
    "build": "npm run tokens && tsup && node scripts/fix-dist-imports.mjs",
    "dev": "tsup --watch --onSuccess \"node scripts/fix-dist-imports.mjs\"",
    "typecheck": "tsc --noEmit",
    "playground": "node playground/build.mjs",
    "test": "node playground/build.mjs --no-open && node playground/test.mjs"
  },
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.24.2",
    "puppeteer-core": "^23.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "peerDependenciesMeta": {
    "lucide-react": {
      "optional": true
    }
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20"
  }
}
