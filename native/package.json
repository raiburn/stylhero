{
  "name": "@stylhero/native",
  "version": "0.1.0",
  "description": "Stylhero design system for React Native: tokens, theming and accessible components",
  "license": "MIT",
  "author": "Oscar Ruíz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raiburn/stylhero.git",
    "directory": "native"
  },
  "keywords": [
    "react-native",
    "expo",
    "design-system",
    "design-tokens",
    "accessibility",
    "components"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "files": [
    "dist",
    "src",
    "!src/**/__tests__"
  ],
  "sideEffects": false,
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "build": "npm run tokens && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-native": ">=0.78"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@react-native/babel-preset": "^0.88.1",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "jest": "^30.5.2",
    "react": "^19.3.1",
    "react-native": "^0.88.1",
    "test-renderer": "^1.3.1",
    "typescript": "^5.9.3"
  }
}
